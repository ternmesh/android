<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A node is found by the service it advertises, never by where the phone is. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 11 and earlier scan under the old permissions, and want location for it. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Location is also asked for when the user shares theirs, and given only to the node, which
         rounds it to what each contact or group was chosen to see. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Firmware for the node, from ternmesh.org, and the map's tiles, from OpenFreeMap. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:name=".TernApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tern">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A node's link (draft/sharing.md in ternmesh/spec), opened here rather than in a
                 browser once ternmesh.org's assetlinks.json names this app. The path's letter is
                 either case: a QR code holds it upper-case. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="ternmesh.org" />
                <data android:pathPrefix="/a/" />
                <data android:pathPrefix="/A/" />
            </intent-filter>
            <!-- The same link as a QR code holds it, upper-case throughout. Android matches a
                 scheme and host case-sensitively, and a scanner may pass the link on as it read
                 it, so this filter is upper-case on purpose (lint takes it for a mistake). It is
                 kept apart from the filter above, whose hosts Android verifies. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="HTTPS" tools:ignore="AppLinkUrlError" />
                <data android:host="TERNMESH.ORG" tools:ignore="AppLinkUrlError" />
                <data android:pathPrefix="/A/" />
                <data android:pathPrefix="/a/" />
            </intent-filter>
        </activity>

        <!-- The code scanner's camera screen, turned with the phone rather than held landscape. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />

        <!-- A reply written in a message notification. Only the notification's intent, which
             names it, reaches it. -->
        <receiver
            android:name=".node.ReplyReceiver"
            android:exported="false" />

        <!-- Keeps the link to the node up while the app is not on screen. -->
        <service
            android:name=".node.NodeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />
    </application>
</manifest>
