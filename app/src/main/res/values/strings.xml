    <!-- First-run setup -->
    <string name="setup_region_title">Where are you?</string>
    <string name="setup_region_explained">Your node does not transmit until it knows which radio rules to follow. Choose the region you are in.</string>
    <string name="region_eu868">Europe and the UK</string>
    <string name="region_us915">The United States, Canada and Mexico</string>
    <string name="setup_region_law">Only use a region that is legal where you are. You can change it later on the Node tab.</string>
    <string name="setup_role_title">Should your node help others?</string>
    <string name="setup_role_explained">A relay passes on messages for nodes it can hear, which helps the mesh reach further but uses more battery. You can change this later.</string>
    <string name="setup_role_leaf">Sends and receives its own messages only. Best for a node you carry.</string>
    <string name="setup_role_relay">Also passes on messages for others. Best for a node left somewhere high, on power.</string>
    <string name="setup_contact_title">Add someone to talk to</string>
    <string name="setup_contact_explained">Your node only accepts messages from contacts. Have a friend scan your code, and scan theirs: each of you adds the other.</string>
